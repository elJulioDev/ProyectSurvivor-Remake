## Devuelve la categoría base para agrupar (para evitar repetición en el roll)
static func get_base_category(cat: String) -> String:
	if cat.begins_with("weapon_"):
		return "weapon_specific"
	return cat

## Devuelve el nombre visual de una categoría
static func get_category_display_name(cat: String) -> String:
	const LABELS := {
		"movement":       "MOVIMIENTO",
		"survival":       "SUPERVIVENCIA",
		"weapons":        "ARMAS",
		"xp":             "XP / GEMAS",
		"curse":          "MALDICION",
		"weapon_pistol":  "PISTOLA",
		"weapon_shotgun": "ESCOPETA",
		"weapon_rifle":   "RIFLE",
		"weapon_sniper":  "FRANCOTIRADOR",
		"weapon_laser":   "LASER",
		"weapon_nova":    "NOVA",
		"weapon_skibidi": "SKIBIDI",
	}
	return LABELS.get(cat, cat.to_upper())